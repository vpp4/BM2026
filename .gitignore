# Build artifacts — all regenerable, see README.md for the pipeline order.
# brc2026.db rebuilds from data/ in seconds; the rest are intermediates that
# get inlined into out/playabrain.html anyway.
brc2026.db
build/payload.json
build/candidates.json
build/schedule.json
build/missed.txt

.DS_Store
*.pyc
__pycache__/

# The built pages ARE the deliverable, so they are committed. Regenerate with
# `python3 build/gen.py && python3 build/assemble.py`.

# The raw DJ lineup stays out: it is pre-release (production rsl.json still
# returns []), and fetch.py pulls it on demand anyway. playabrain.html embeds
# the parts of it people actually need.
data/bm_rsl.json

# Secrets. This repo is PUBLIC — never commit a key.
.env
.env.*
!.env.example
# Bulk official-API output: the Burning Man API Terms of Service govern
# redistribution, so keep it local until you've read them.
data/bm_api_*.json
